{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.onehundo.org/v0.1.0/events/semantic-event.schema.json",
  "title": "OneHundo Plane B Semantic Event",
  "description": "Normative schema for Plane B semantic gameplay facts emitted by source ports, decompilations, and instrumented runtimes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonical_game_id",
    "producer_id",
    "session_id",
    "sequence_number",
    "idempotency_key",
    "timestamp_nanos",
    "event_type",
    "key",
    "progression_mode",
    "trust_tier",
    "evidence_class",
    "verification_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "canonical_game_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "description": "Deterministic composite key: producer_id:session_id:sequence_number"
    },
    "timestamp_nanos": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": ["STAT_SET", "STAT_INC", "STATE_OBSERVE", "UNLOCK_REQUEST"]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stat name, state variable key, or canonical achievement ID."
    },
    "int_value": {
      "type": "integer"
    },
    "float_value": {
      "type": "number"
    },
    "string_value": {
      "type": "string",
      "maxLength": 512
    },
    "progression_mode": {
      "type": "string",
      "enum": ["STANDARD", "ENCORE", "SPECTATOR"]
    },
    "trust_tier": {
      "type": "string",
      "enum": ["LOCAL", "VERIFIED_INTEGRATION", "COMPETITIVE"]
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "DIRECT_INTEGRATION_EVENT",
        "RUNTIME_OBSERVED",
        "PLATFORM_CONFIRMED",
        "LOCALLY_OBSERVED",
        "INFERRED"
      ]
    },
    "verification_state": {
      "type": "string",
      "enum": ["PENDING", "VERIFIED", "UNVERIFIED", "REJECTED"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  }
}
